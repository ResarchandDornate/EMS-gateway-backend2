# .env.staging.example — copy to .env.staging, then fill in real staging values.
# .env.staging is gitignored; NEVER commit it. Do not put production secrets here.
# This file is used BOTH as the api container env (env_file) AND for compose interpolation
# (pass --env-file .env.staging on the docker compose command).

ENV=staging

# --- secrets (REQUIRED; compose fails fast if unset) ---
POSTGRES_PASSWORD=CHANGE_ME_staging_db_password
INFLUXDB_ADMIN_PASSWORD=CHANGE_ME_staging_influx_password
INFLUXDB_ADMIN_TOKEN=CHANGE_ME_staging_influx_token
JWT_SECRET=CHANGE_ME_staging_jwt_secret

# --- CORS (REQUIRED; explicit staging frontend origin(s), comma-separated; never '*') ---
CORS_ALLOWED_ORIGINS=https://CHANGE_ME-staging-frontend.example
CORS_ALLOW_CREDENTIALS=false

# --- app settings read from this file by the api container ---
INGEST_ENABLED=false
# Container-network hosts (compose 'environment:' overrides these too; kept for clarity / host runs).
DATABASE_URL=postgresql+asyncpg://ems_staging:CHANGE_ME_staging_db_password@postgres:5432/ems_staging
INFLUX_URL=http://influxdb:8086
INFLUX_TOKEN=CHANGE_ME_staging_influx_token
INFLUX_ORG=unityess_staging
INFLUX_BUCKET_RAW=telemetry_raw_90d_staging
INFLUX_BUCKET_LONG=telemetry_1y_staging
INFLUX_BUCKET_3Y=telemetry_3y_staging
REDIS_URL=redis://redis:6379/0
